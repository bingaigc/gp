# Multi-stage Dockerfile for Alpha Detector Service
# Supports both x86_64 and ARM64 architectures

# Stage 1: Builder
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build both CLI and Service binaries
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X main.Version=2.0.0 -X main.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" -o alpha-detector ./cmd/alpha/main.go
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X main.Version=2.0.0 -X main.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" -o alpha-detector-service ./cmd/service/main.go

# Stage 2: Runtime
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata curl

# Create non-root user
RUN addgroup -g 1000 alpha && \
    adduser -D -u 1000 -G alpha alpha

# Set working directory
WORKDIR /app

# Copy binaries from builder
COPY --from=builder /build/alpha-detector /app/alpha-detector
COPY --from=builder /build/alpha-detector-service /app/alpha-detector-service

# Copy configuration files
COPY configs/config.example.yaml /app/configs/config.yaml

# Create directories for data and logs
RUN mkdir -p /app/data /app/logs /tmp/alpha && \
    chown -R alpha:alpha /app /tmp/alpha

# Switch to non-root user
USER alpha

# Expose ports
EXPOSE 8080 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Default environment variables
ENV RUN_MODE=all \
    API_PORT=8080 \
    LOG_LEVEL=info \
    LOG_FORMAT=json \
    CONFIG_PATH=/app/configs/config.yaml

# Default command: run service
CMD ["/app/alpha-detector-service"]
