# ===== 环境变量配置示例 =====
# 复制此文件为 .env 并填写实际值

# Kimi AI API Key (必填)
ALPHA_KIMI_API_KEY=your-kimi-api-key-here

# 系统配置
ALPHA_ENV=development
ALPHA_LOG_LEVEL=info

# 数据源配置
ALPHA_DATA_SOURCE=eastmoney

# 风控配置
ALPHA_DAILY_MAX_LOSS=50000
ALPHA_MAX_SIGNALS_PER_DAY=20

# Pipeline配置
ALPHA_WORKERS=3
ALPHA_BATCH_SIZE=20
ALPHA_LIMIT=100
